        </properties>
      </component>
      <component id="cbabc" class="javax.swing.JFormattedTextField" binding="enterAmountToPayFormattedTextField" default-binding="true">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="Enter amount to pay"/>
          <toolTipText value="Numbers only"/>
        </properties>
      </component>
      <component id="edb68" class="javax.swing.JButton" binding="payButton" default-binding="true">
